# Web Intel environment configuration
# Copy this file to ".env.local" and adjust as needed.
# No API keys required — the app runs fully offline.

# Ollama (local LLM server). Default: http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# Ollama model tag. Default: gemma4:e2b
# Make sure you have pulled it:  ollama pull gemma4:e2b
OLLAMA_MODEL=gemma4:e2b

# MongoDB connection string. Default: mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017

# MongoDB database name. Default: webintel
MONGODB_DB=webintel